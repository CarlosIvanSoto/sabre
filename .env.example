# Plantilla de variables. Copiar a .env (cert/sandbox), .env.production o .env.devcenter
# y llenar. Uso: node --env-file=.env examples/run-air-booking-flow.mjs
#
# Un solo juego de credenciales para REST (Sabre) y SOAP (SabreLegacy). Los ejemplos y scripts
# arman el EPR con buildCredentials: <user>-<PCC>-<domain> (v3) o V1:<user>:<PCC>:<domain> (v2).

# Entorno: sandbox (default) o production
SABRE_ENVIRONMENT=
# Versión de OAuth: v3 (default) o v2. Solo cambia el formato del username.
SABRE_AUTH_VERSION=

# EPR: solo el usuario, sin PCC ni domain
SABRE_USERNAME=
# PCC de las credenciales (el group del EPR)
SABRE_PCC=
# Domain del EPR. Vacío: AA
SABRE_DOMAIN=
SABRE_PASSWORD=

# ClientID de la app: obligatorio con v3; con v2, los dos o ninguno
# (con los dos, SabreLegacy abre la sesión con SessionCreateRQ 2.0.0)
SABRE_CLIENT_ID=
SABRE_CLIENT_SECRET=

# No es credencial: PCC donde se busca, reserva, consulta y cancela (targetPcc). Vacío: SABRE_PCC.
SABRE_TARGET_PCC=
# Número DK del cliente (6, 7 o 10 caracteres)
SABRE_AGENCY_CUSTOMER_NUMBER=

# Pasajero real del piloto: datos de una persona que consiente la reserva (solo producción)
SABRE_TRAVELER_GIVEN_NAME=
SABRE_TRAVELER_SURNAME=
SABRE_TRAVELER_EMAIL=
SABRE_TRAVELER_PHONE=
