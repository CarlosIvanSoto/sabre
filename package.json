{
  "name": "sabre-client",
  "version": "0.9.1",
  "description": "TypeScript SDK for Sabre GDS REST and SOAP APIs: air shopping, booking, seats, ticketing, sessions and queues.",
  "author": "Carlos Ivan Soto Pérez (https://github.com/CarlosIvanSoto)",
  "keywords": [
    "sabre",
    "sabre-gds",
    "sabre-api",
    "sabre-sdk",
    "gds",
    "travel",
    "airline",
    "flight-booking",
    "bargain-finder-max",
    "ticketing",
    "pnr",
    "soap",
    "rest",
    "sdk",
    "nodejs",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarlosIvanSoto/sabre.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./anonymize": {
      "types": "./dist/anonymize.d.ts",
      "import": "./dist/anonymize.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:portable": "node scripts/check-portable.mjs src"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  }
}
