{
  "compilerOptions": {
    "target": "ES2022",
    // Solo Web Standard APIs: "DOM"/"DOM.Iterable" aportan los tipos de fetch, Request/Response,
    // TextEncoder y timers. Sin @types/node para que una API Node-only no compile.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test"]
}
